# ─────────────────────────────────────────────────────────────
# fletway-mobile — variables de entorno (ejemplo)
# Copiar a .env. .env está en .gitignore y se carga con flutter_dotenv.
# ─────────────────────────────────────────────────────────────

# --- Backend Go (lógica de negocio: cotización, ofertas, viajes, pagos, PIN) ---
API_BASE_URL=http://10.0.2.2:8080/api      # 10.0.2.2 = localhost del host desde el emulador Android
API_TIMEOUT_MS=15000

# --- Supabase (Auth GoTrue + Realtime: chat RF-10/20, GPS RI-04/RF-15) ---
SUPABASE_URL=https://gfadryudaaqyxnkrpbex.supabase.co
SUPABASE_ANON_KEY=                          # clave anon pública del proyecto dbFletway

# --- Entorno ---
APP_ENV=development                          # development | staging | production
LOG_LEVEL=debug
