# ─────────────────────────────────────────────────────────────
# fletway-mobile — variables de entorno (ejemplo)
# Copiar a .env. .env está en .gitignore y se carga con flutter_dotenv.
# ─────────────────────────────────────────────────────────────

# --- Backend Go (lógica de negocio: cotización, ofertas, viajes, pagos, PIN) ---
API_BASE_URL=http://10.0.2.2:8080/api      # 10.0.2.2 = localhost del host desde el emulador Android
API_TIMEOUT_MS=15000

# --- Supabase (Auth GoTrue + Realtime: chat RF-10/20, GPS RI-04/RF-15) ---
# Desarrollo = Supabase local (D-16): `make db-local` en fletway-backend levanta el
# stack y `supabase status` muestra la clave. 10.0.2.2 es el host desde el emulador.
# Producción (dbFletway, https://gfadryudaaqyxnkrpbex.supabase.co) sólo para builds de
# release; nunca para desarrollo ni tests.
SUPABASE_URL=http://10.0.2.2:54321
# Supabase renombró "anon key" → "publishable key". Usar la nueva; si el proyecto
# todavía expone la vieja, SUPABASE_ANON_KEY sirve como fallback.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# --- Entorno ---
APP_ENV=development                          # development | production (D-16)
LOG_LEVEL=debug
